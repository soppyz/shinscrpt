local BAG_LIMIT = 40 -- reset only after this many candy

-- Read the real bag counter ("3/10" style label) from the game's GUI
local bagLabel
local function findBagLabel()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return nil end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextLabel") and not d:IsDescendantOf(screenGui) then
            local t = d.Text:gsub("<[^>]+>", "")
            local a, b = t:match("^%s*(%d+)%s*/%s*(%d+)%s*$")
            if a and tonumber(b) == BAG_LIMIT then
                local path = d:GetFullName():lower()
                if path:find("coin") or path:find("candy") or path:find("bag") or path:find("maingui") then
                    return d
                end
            end
        end
    end
    return nil
end

