    label(r, "30", UDim2.new(0, 30, 0, 12), UDim2.new(1, -46, 0, 64), 10, C.sub, Enum.Font.GothamBold, Enum.TextXAlignment.Right)

    local MIN, MAX = 20, 30
    local function setSpeed(v)
        v = math.clamp(math.round(v), MIN, MAX)
        state.speed = v
        local pct = (v - MIN) / (MAX - MIN)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, 0, 0.5, 0)
        box.Text = tostring(v)
    end
    setSpeed(state.speed)

    local sliding = false
    local function fromInput(input)
        local pct = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        setSpeed(MIN + pct * (MAX - MIN))
    end
    track(bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            fromInput(input)
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            fromInput(input)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end))
end

addToggle(4, "Anti Fling / Void", nil, true, function(v)
    state.antiFling = v
end)

