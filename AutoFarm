local function getRoot()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart"), char and char:FindFirstChildOfClass("Humanoid")
end

local function findContainer()
    return workspace:FindFirstChild("CoinContainer", true)
end

local function coinPart(obj)
    if obj:IsA("BasePart") then return obj end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("TouchInterest") and d.Parent:IsA("BasePart") then
            return d.Parent
        end
    end
    return obj:FindFirstChildWhichIsA("BasePart", true)
end

local function nearestCoin(container, root)
    local best, bestDist, bestPart
    for _, c in ipairs(container:GetChildren()) do
        local p = coinPart(c)
        if p and p.Parent then
            local d = (p.Position - root.Position).Magnitude
            if not bestDist or d < bestDist then
                best, bestDist, bestPart = c, d, p
            end
        end
    end
    return best, bestPart, bestDist
end

