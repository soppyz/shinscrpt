-- ── HELPER: button ────────────────────────────────────────────
local function makeButton(yPos, text)
	local btn = Instance.new("TextButton", frame)
	btn.Size = UDim2.new(0, 250, 0, 32)
	btn.Position = UDim2.new(0.5, -125, 0, yPos)
	btn.Text = text
	btn.BackgroundColor3 = C.BtnOff
	btn.TextColor3 = C.TextHi
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 13
	btn.BorderSizePixel = 0
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)
	local s = Instance.new("UIStroke", btn)
	s.Color = Color3.fromRGB(120, 40, 0)
	s.Thickness = 1

	btn.MouseEnter:Connect(function()
		if btn.BackgroundColor3 ~= C.BtnOn then
			btn.BackgroundColor3 = C.BtnHover
		end
	end)
	btn.MouseLeave:Connect(function()
		if btn.BackgroundColor3 ~= C.BtnOn then
			btn.BackgroundColor3 = C.BtnOff
		end
	end)
	return btn
end

