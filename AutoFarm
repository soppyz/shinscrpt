-- Minimize / close / unload
---------------------------------------------------------------------
local minimized = false
track(minBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    body.Visible = not minimized
    main.Size = minimized and UDim2.new(0, 400, 0, 56) or UDim2.new(0, 400, 0, 370)
end))

local function unload()
    state.alive = false
    state.farm = false
    state.active = false
    removeMover()
    if farmThread then pcall(task.cancel, farmThread) end
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    local char = player.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and (p.Name == "HumanoidRootPart" or p.Name == "Torso" or p.Name == "Head") then
                p.CanCollide = true
            end
        end
    end
    screenGui:Destroy()
end
track(closeBtn.MouseButton1Click:Connect(unload))
if getgenv then getgenv().HalloweenFarmUnload = unload end
