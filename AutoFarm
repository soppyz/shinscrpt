local function restoreCollision()
    local char = player.Character
    if not char then return end
    for _, n in ipairs({ "HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso" }) do
        local part = char:FindFirstChild(n)
        if part and part:IsA("BasePart") then part.CanCollide = true end
    end
end

local function resetCharacter()
    local _, hum = getRoot()
    if hum then hum.Health = 0 end
    local t = os.clock()
    repeat task.wait(0.25) until (player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        and player.Character:FindFirstChildOfClass("Humanoid")
        and player.Character:FindFirstChildOfClass("Humanoid").Health > 0) or os.clock() - t > 15
    task.wait(1.5)
end

local ROUND_RANGE = 400   -- nearest coin farther than this = you're in the lobby
local IDLE_GRACE = 0.6    -- keep noclip this long after the last move (no collision "pop")

-- Physics-based mover: glides at a real velocity instead of teleporting every frame
local mover, moverAtt
local function removeMover()
    if mover then mover:Destroy() mover = nil end
    if moverAtt then moverAtt:Destroy() moverAtt = nil end
end

local function ensureMover(root)
    if mover and mover.Parent and moverAtt and moverAtt.Parent == root then
        return mover
    end
    removeMover()
    moverAtt = Instance.new("Attachment")
    moverAtt.Name = "FarmAtt"
    moverAtt.Parent = root
    mover = Instance.new("LinearVelocity")
    mover.Attachment0 = moverAtt
    mover.RelativeTo = Enum.ActuatorRelativeTo.World
    mover.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    mover.MaxForce = math.huge
    mover.VectorVelocity = Vector3.zero
    mover.Parent = root
    return mover
end

local farmThread
local function startFarm()
    if farmThread then task.cancel(farmThread) end
    farmThread = task.spawn(function()
        local target, part, targetHadTI
        local blacklist, pending = {}, {}
        local failStreak, lastReset, lastMove = 0, 0, 0
        local wasActive = false

        -- returns target, part, hadTouchInterest | nil, nil, nil, tooFar
        local function pick(children, hasTI, root, now)
            local bestD, bt, bp
            for _, c in ipairs(children) do
                if not pending[c] and not (blacklist[c] and blacklist[c] > now) then
                    local cp = coinPart(c)
                    if cp and cp.Parent and cp.CanTouch ~= false
                        and ((not hasTI) or cp:FindFirstChildOfClass("TouchInterest")) then
                        local d = (cp.Position - root.Position).Magnitude
                        if not bestD or d < bestD then
                            bestD, bt, bp = d, c, cp
                        end
                    end
                end
            end
            if bt and bestD > ROUND_RANGE then
                return nil, nil, nil, true
            end
            if bt then
                return bt, bp, bp:FindFirstChildOfClass("TouchInterest") ~= nil, false
            end
            return nil, nil, nil, false
        end

        while state.farm and state.alive do
            local dt = RunService.Heartbeat:Wait()
            local now = os.clock()
            local root, hum = getRoot()
            local container = findContainer()
            local moving = false

            -- Resolve fired pickups: coin removed / disabled = success
            for coin, info in pairs(pending) do
                local pp = info.part
                local done = (not coin.Parent) or (not pp.Parent) or pp.CanTouch == false
                    or (info.hadTI and not pp:FindFirstChildOfClass("TouchInterest"))
                if done then
                    pending[coin] = nil
                    state.collected += 1
                    if not state.bagFromGui then state.bag += 1 end
                    failStreak = 0
                elseif now - info.t > 1.2 then
                    pending[coin] = nil
                    blacklist[coin] = now + 6
                    failStreak += 1
                end
            end

            if not (root and hum and hum.Health > 0 and container) then
                -- no round / dead
                target, part = nil, nil
                state.waiting = true
                removeMover()
                if not container then
                    table.clear(blacklist)
                    table.clear(pending)
                    failStreak = 0
                    if not state.bagFromGui then state.bag = 0 end
                end
                task.wait(0.4)
            else
                -- live coins have a TouchInterest
                local hasTI = false
                local children = container:GetChildren()
                for _, c in ipairs(children) do
                    local cp = coinPart(c)
                    if cp and cp:FindFirstChildOfClass("TouchInterest") then
                        hasTI = true
                        break
                    end
                end

                if state.bag >= BAG_LIMIT then
                    -- bag full: reset only now (40/40)
                    target, part = nil, nil
                    state.waiting = false
                    removeMover()
                    if state.respawn and now - lastReset > 8 then
                        lastReset = now
                        resetCharacter()
                        state.bag = 0
                        failStreak = 0
                        table.clear(blacklist)
                        table.clear(pending)
                    else
                        task.wait(0.4)
                    end
                else
                    -- keep current target only while still valid
                    if target then
                        local ok = target.Parent and part and part.Parent and part.CanTouch ~= false
                            and not pending[target] and not (blacklist[target] and blacklist[target] > now)
                            and ((not hasTI) or part:FindFirstChildOfClass("TouchInterest"))
                        if not ok then target, part = nil, nil end
                    end

                    if not target then
                        local far
                        target, part, targetHadTI, far = pick(children, hasTI, root, now)
                        state.waiting = far and true or false
                    end

                    if target then
                        local delta = part.Position - root.Position
                        local dist = delta.Magnitude

                        if dist <= 3 then
                            touch(root, part)
                            pending[target] = { t = now, part = part, hadTI = targetHadTI }
                            -- chain straight to the next coin, no stop in between
                            target, part, targetHadTI = pick(children, hasTI, root, now)
                            if target then
                                delta = part.Position - root.Position
                                dist = delta.Magnitude
                            end
                        end

                        if target then
                            local m = ensureMover(root)
                            -- never overshoot: slow to exactly the remaining distance
                            local spd = math.min(state.speed, dist / math.max(dt, 1 / 120))
                            m.VectorVelocity = dist > 0.01 and (delta.Unit * spd) or Vector3.zero
                            lastMove = now
                            moving = true
                        end
                    end

                    if not moving then
                        if mover then mover.VectorVelocity = Vector3.zero end
                        if now - lastMove > IDLE_GRACE then removeMover() end
                    end
                end
            end

            -- noclip stays on a moment after the last move so you aren't "popped" out of walls
            local active = moving or (now - lastMove < IDLE_GRACE)
            state.active = active
            if wasActive and not active then restoreCollision() end
            wasActive = active
        end

        removeMover()
        state.active = false
        state.waiting = false
        restoreCollision()
    end)
end

