track(RunService.Stepped:Connect(function()
    if not state.antiFling then return end
    local root = getRoot()
    if not root then return end

    -- remember last safe spot
    if root.Position.Y > -50 and root.AssemblyLinearVelocity.Magnitude < 80 then
        lastSafeCFrame = root.CFrame
    end

    -- anti fling: kill extreme velocity
    if root.AssemblyLinearVelocity.Magnitude > 120 or root.AssemblyAngularVelocity.Magnitude > 60 then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    -- anti void: go back if falling out of the map
    if root.Position.Y < -100 and lastSafeCFrame then
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = lastSafeCFrame
    end

    -- other players can't push you
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and other.Character then
            for _, p in ipairs(other.Character:GetChildren()) do
                if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
            end
        end
    end
end))

